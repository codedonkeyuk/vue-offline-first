{
  "name": "vue-offline-first",
  "version": "0.0.20",
  "description": "A fullstack template application employing offline first model. Written in Vue, CouchDB and DocumentDb.",
  "homepage": "https://github.com/codedonkeyuk/vue-offline-first#readme",
  "bugs": {
    "url": "https://github.com/codedonkeyuk/vue-offline-firstissues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.comcodedonkeyuk/vue-offline-first.git"
  },
  "workspaces": [
    "./workspace/database/local-db",
    "./workspace/database/db-config",
    "./workspace/service/*",
    "./workspace/web/*"
  ],
  "private": true,
  "scripts": {
    "serve": "concurrently -k -n auth,web -c cyan,magenta \"npm run serve -w @vue-offline-first/auth-service\" \"npm run serveDev -w @vue-offline-first/site\"",
    "clean": "prettier . --write && npx oxlint --type-aware --fix",
    "validate": "prettier . --check && npx oxlint --type-aware && npx cspell --exclude \"**/node_modules/**\" **/*.md",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge": "npm:@fastify/deepmerge@^3.2.4",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "pouchdb-browser": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
