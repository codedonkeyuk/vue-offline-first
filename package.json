{
  "name": "job-search",
  "version": "0.0.4",
  "description": "A fullstack application to help with job searchs",
  "homepage": "https://github.com/codedonkeyuk/job-search#readme",
  "bugs": {
    "url": "https://github.com/codedonkeyuk/job-searchissues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.comcodedonkeyuk/job-search.git"
  },
  "workspaces": [
    "./workspace/web/*"
  ],
  "private": true,
  "scripts": {
    "serve": "concurrently -k -n auth,web -c cyan,magenta \"npm run serve -w auth-service\" \"npm run serveDev -w job-search-site\"",
    "clean": "prettier . --write",
    "validate": "prettier . --check && npx cspell **/*.md",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge": "npm:@fastify/deepmerge@^3.2.4",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
