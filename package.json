{
  "name": "job-search",
  "version": "0.0.3",
  "description": "A fullstack application to help with job searchs",
  "homepage": "https://github.com/codedonkeyuk/job-search#readme",
  "bugs": {
    "url": "https://github.com/codedonkeyuk/job-searchissues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.comcodedonkeyuk/job-search.git"
  },
  "workspaces": [
    "./workspace/web/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "validate": "npx cspell README.md && npm run validate --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": 
  {
    "cspell": "^10.0.1",
    "husky": "^9.1.7"
  },
  "overrides": {
    "deepmerge": "npm:@fastify/deepmerge@^3.2.4",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}