# Server-to-server (used inside Docker by auth-service)
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
JWT_SECRET=local-dev-secret
SESSION_TTL=1800

# Browser-to-Nginx (used by the Vue frontend in the user's browser)
VITE_AUTH_API_URL=http://localhost:8080/auth
VITE_COUCH_BASE_URL=http://localhost:8080/db