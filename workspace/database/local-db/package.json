{
  "name": "@vue-offline-first/local-db",
  "version": "0.0.1",
  "description": "A implementation of a pouchdb database for use within a web application",
  "license": "MIT",
  "author": "Leigh",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "clean": "npx oxlint --type-aware --fix",
    "validate": "npx oxlint --type-aware && tsc --noEmit && npx cspell README.md",
    "prebuild": "npx oxlint --type-aware && tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test \"**/*.test.ts\"",
    "coverage": "node --experimental-strip-types --experimental-test-module-mocks --test --experimental-test-coverage \"**/*.test.ts\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pouchdb-adapter-http": "^6.1.6",
    "@types/pouchdb-adapter-idb": "^6.1.7",
    "@types/pouchdb-adapter-memory": "^6.1.6",
    "@types/pouchdb-core": "^7.0.15",
    "@types/pouchdb-replication": "^6.4.7",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "pouchdb-adapter-memory": "^9.0.0",
    "pouchdb-core": "^9.0.0",
    "prettier": "3.9.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vue-offline-first/db-config": "*",
    "pouchdb-adapter-http": "^9.0.0",
    "pouchdb-adapter-idb": "^9.0.0",
    "pouchdb-replication": "^9.0.0"
  },
  "peerDependencies": {
    "pouchdb-core": "^9.0.0"
  }
}
